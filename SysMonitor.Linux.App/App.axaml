<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:SysMonitor.Linux.App"
             x:Class="SysMonitor.Linux.App.App">
  <Application.Resources>
    <ResourceDictionary>
      <app:LineCentreConverter x:Key="LineCentre" />

      <!-- Amendment 1: an unticked box is the palette Muted colour at 60 %.
           The palette follows the light/dark variant, so the brush does too;
           #cbd5e1 is Dark Muted and #64748b is Light Muted. -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="CheckBorderBrush" Color="#99cbd5e1" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="CheckBorderBrush" Color="#9964748b" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- Amendment 1: our own compact CheckBox. The template is built from a
           plain Grid/Border/Path so it does not depend on any Fluent part name;
           only the content presenter is a named element, and the control
           itself handles the click, so the label still toggles. -->
      <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
          <ControlTemplate>
            <Grid x:Name="Root"
                  Background="Transparent"
                  ColumnDefinitions="Auto,*"
                  MinHeight="0">
              <Grid x:Name="Mark"
                    Width="14"
                    Height="14"
                    VerticalAlignment="Top"
                    Margin="{TemplateBinding FontSize, Converter={StaticResource LineCentre}}">
                <Border x:Name="FocusRing"
                        Margin="-3"
                        CornerRadius="5"
                        BorderThickness="1"
                        BorderBrush="Transparent"
                        IsHitTestVisible="False" />
                <Border x:Name="Box"
                        CornerRadius="3"
                        BorderThickness="1"
                        Background="Transparent"
                        BorderBrush="{DynamicResource CheckBorderBrush}" />
                <Path x:Name="Tick"
                      Width="9"
                      Height="9"
                      Data="M 0.5,4.6 L 3.3,7.3 L 8.5,1.2"
                      Stroke="#ffffff"
                      StrokeThickness="1.6"
                      StrokeLineCap="Round"
                      StrokeJoin="Round"
                      Stretch="Uniform"
                      IsVisible="False"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
              </Grid>
              <ContentPresenter Grid.Column="1"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                FontFamily="{TemplateBinding FontFamily}"
                                FontSize="{TemplateBinding FontSize}"
                                FontWeight="{TemplateBinding FontWeight}"
                                Foreground="{TemplateBinding Foreground}" />
            </Grid>
          </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ Border#Box">
          <Setter Property="BorderBrush" Value="#3b82f6" />
        </Style>
        <Style Selector="^:checked /template/ Border#Box">
          <Setter Property="Background" Value="#3b82f6" />
          <Setter Property="BorderBrush" Value="#3b82f6" />
        </Style>
        <Style Selector="^:checked /template/ Path#Tick">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#FocusRing">
          <Setter Property="BorderBrush" Value="#3b82f6" />
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Opacity" Value="0.5" />
        </Style>
      </ControlTheme>

      <!-- Amendment 1: the same mark for a radio row: a 14 px circle, a blue
           ring and a 6 px dot when checked. Grouping and toggling stay with
           RadioButton itself. -->
      <ControlTheme x:Key="{x:Type RadioButton}" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
          <ControlTemplate>
            <Grid x:Name="Root"
                  Background="Transparent"
                  ColumnDefinitions="Auto,*"
                  MinHeight="0">
              <Grid x:Name="Mark"
                    Width="14"
                    Height="14"
                    VerticalAlignment="Top"
                    Margin="{TemplateBinding FontSize, Converter={StaticResource LineCentre}}">
                <Border x:Name="FocusRing"
                        Margin="-3"
                        CornerRadius="10"
                        BorderThickness="1"
                        BorderBrush="Transparent"
                        IsHitTestVisible="False" />
                <Border x:Name="Ring"
                        CornerRadius="7"
                        BorderThickness="1"
                        Background="Transparent"
                        BorderBrush="{DynamicResource CheckBorderBrush}" />
                <Ellipse x:Name="Dot"
                         Width="6"
                         Height="6"
                         Fill="#3b82f6"
                         IsVisible="False"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
              </Grid>
              <ContentPresenter Grid.Column="1"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                FontFamily="{TemplateBinding FontFamily}"
                                FontSize="{TemplateBinding FontSize}"
                                FontWeight="{TemplateBinding FontWeight}"
                                Foreground="{TemplateBinding Foreground}" />
            </Grid>
          </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ Border#Ring">
          <Setter Property="BorderBrush" Value="#3b82f6" />
        </Style>
        <Style Selector="^:checked /template/ Border#Ring">
          <Setter Property="BorderBrush" Value="#3b82f6" />
        </Style>
        <Style Selector="^:checked /template/ Ellipse#Dot">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#FocusRing">
          <Setter Property="BorderBrush" Value="#3b82f6" />
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Opacity" Value="0.5" />
        </Style>
      </ControlTheme>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <!-- Spec section 1: one family for the whole program. The three views set
         it on their own windows, but a tooltip or a context menu lives in its
         own popup root and would otherwise fall back to the system default, so
         the theme default repeats it here. The family itself is declared once,
         in Ui.FontStack. -->
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="{x:Static app:Ui.Family}" />
    </Style>
    <Style Selector="ToolTip">
      <Setter Property="FontFamily" Value="{x:Static app:Ui.Family}" />
    </Style>
    <Style Selector="ContextMenu">
      <Setter Property="FontFamily" Value="{x:Static app:Ui.Family}" />
    </Style>

    <!-- Amendment 1: every TextBlock built outside Ui.Text still gets a
         font, but LineHeight is absolute in Avalonia, so the 1.36 em value
         cannot live in a style. Ui.Text sets it per block; this comment is the
         record of why no TextBlock style sets it. -->

    <!-- Spec section 6: a 10 px scrollbar with no arrows and a grey thumb.
         Fluent still owns the rest of the template; these only restyle it. -->
    <Style Selector="ScrollBar:vertical">
      <Setter Property="Width" Value="10" />
    </Style>
    <Style Selector="ScrollBar:vertical /template/ Thumb">
      <Setter Property="Background" Value="#55808080" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Margin" Value="2,0,2,0" />
    </Style>
    <Style Selector="ScrollBar:vertical:pointerover /template/ Thumb">
      <Setter Property="Background" Value="#99808080" />
    </Style>
    <Style Selector="ScrollBar:vertical /template/ RepeatButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </Application.Styles>
</Application>
