<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SysMonitor.Linux.App.App">
  <Application.Styles>
    <FluentTheme />

    <!-- Spec section 6: a 10 px scrollbar with no arrows and a grey thumb.
         Fluent still owns the rest of the template; these only restyle it. -->
    <Style Selector="ScrollBar:vertical">
      <Setter Property="Width" Value="10" />
    </Style>
    <Style Selector="ScrollBar:vertical /template/ Thumb">
      <Setter Property="Background" Value="#55808080" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Margin" Value="2,0,2,0" />
    </Style>
    <Style Selector="ScrollBar:vertical:pointerover /template/ Thumb">
      <Setter Property="Background" Value="#99808080" />
    </Style>
    <Style Selector="ScrollBar:vertical /template/ RepeatButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </Application.Styles>
</Application>
