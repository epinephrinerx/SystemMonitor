<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Linux sensors. Every reader takes a root directory (default "/") and
         reads /proc, /sys and two user-level commands from underneath it, so a
         test can feed a fake tree. No packages. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SysMonitor.Linux</RootNamespace>
    <AssemblyName>SysMonitor.Linux</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SysMonitor.Core\SysMonitor.Core.csproj" />
  </ItemGroup>

</Project>
