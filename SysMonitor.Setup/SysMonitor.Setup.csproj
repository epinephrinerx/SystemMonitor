<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SysMonitor-Setup</AssemblyName>
    <RootNamespace>SysMonitor.Setup</RootNamespace>
    <Version>3.0.2</Version>
    <FileVersion>3.0.2.0</FileVersion>
    <Company>SysMonitor</Company>
    <Product>SysMonitor</Product>
    <Description>SysMonitor installer</Description>
    <ApplicationManifest>..\SysMonitor.Wpf\app.manifest</ApplicationManifest>
    <ApplicationIcon>..\SysMonitor.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- The application to install, embedded so the setup is one file.
       build-wpf.cmd publishes SysMonitor.Wpf and drops the result here. -->
  <ItemGroup>
    <EmbeddedResource Include="payload\SysMonitor.exe" LogicalName="SysMonitor.exe"
                      Condition="Exists('payload\SysMonitor.exe')" />
  </ItemGroup>

</Project>
