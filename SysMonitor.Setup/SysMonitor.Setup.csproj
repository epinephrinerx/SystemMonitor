<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SystemMonitor-Setup</AssemblyName>
    <RootNamespace>SysMonitor.Setup</RootNamespace>
    <Version>4.2.0</Version>
    <FileVersion>4.2.0.0</FileVersion>
    <Company>System Monitor</Company>
    <Product>System Monitor</Product>
    <Description>System Monitor installer</Description>
    <ApplicationManifest>..\SysMonitor.Wpf\app.manifest</ApplicationManifest>
    <ApplicationIcon>..\SysMonitor.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- The application to install, embedded so the setup is one file.
       build-wpf.cmd publishes SysMonitor.Wpf and drops the result here. -->
  <ItemGroup>
    <EmbeddedResource Include="payload\SystemMonitor.exe" LogicalName="SystemMonitor.exe"
                      Condition="Exists('payload\SystemMonitor.exe')" />
  </ItemGroup>

</Project>
